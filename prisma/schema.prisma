generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------
// SHARED ENUMS
// ----------------------------------------

enum WalletType {
  USER
  SETTLEMENT
  FEE
  RESERVE
  PAYOUT
  LIQUIDITY
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

// ----------------------------------------
// FINANCIAL CORE DOMAIN
// ----------------------------------------

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String   @db.Uuid
  currency         String   @db.VarChar(5)
  wallet_type      WalletType
  stellar_public_key String?  @db.VarChar(56)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  accounts         LedgerAccount[]

  @@unique([user_id, currency])
  @@map("wallets")
}

model LedgerAccount {
  id               String   @id @default(uuid()) @db.Uuid
  wallet_id        String   @db.Uuid
  account_type     AccountType
  currency         String   @db.VarChar(5)
  name             String   @db.VarChar(100)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz

  wallet           Wallet   @relation(fields: [wallet_id], references: [id])
  entries          LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id                String   @id @default(uuid()) @db.Uuid
  transaction_id    String   @db.Uuid
  ledger_account_id String   @db.Uuid
  entry_type        EntryType
  amount            Decimal  @db.Decimal(18, 4)
  currency          String   @db.VarChar(5)
  description       String   @db.VarChar(255)
  reference_type    String?  @db.VarChar(30)
  reference_id      String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz

  account           LedgerAccount @relation(fields: [ledger_account_id], references: [id])

  @@index([ledger_account_id, created_at])
  @@index([transaction_id])
  @@map("ledger_entries")
}

enum TransferStatus {
  CREATED
  PENDING_KYC
  FX_LOCKED
  WALLET_DEBITED
  BLOCKCHAIN_PENDING
  COMPLETED
  FAILED
}

model Transfer {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  amount          Decimal        @db.Decimal(18, 4)
  currency        String         @db.VarChar(5)
  status          TransferStatus @default(CREATED)
  idempotencyKey  String         @unique @map("idempotency_key") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  @@map("transfers")
}

// ----------------------------------------
// AUTH & USERS DOMAIN
// ----------------------------------------

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(255)
  phoneNumber     String?  @unique @map("phone_number") @db.VarChar(20)
  passwordHash    String?  @map("password_hash") @db.VarChar(255)
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  isPhoneVerified Boolean  @default(false) @map("is_phone_verified")
  kycStatus       String   @default("UNVERIFIED") @map("kyc_status") @db.VarChar(20)
  kycTier         String   @default("NONE") @map("kyc_tier") @db.VarChar(10)
  role            String   @default("USER") @db.VarChar(20)
  isActive        Boolean  @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // MFA Config Fields
  isMfaEnabled    Boolean  @default(false) @map("is_mfa_enabled")
  mfaSecret       String?  @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes  String[] @default([]) @map("mfa_backup_codes")

  profile         UserProfile?
  sessions        AuthSession[]
  otpCodes        OtpCode[]
  socialAccounts  SocialAccount[]
  kycDocuments    KycDocument[]
  kycAttempts     KycVerificationAttempt[]
  pointsAccount   PointsAccount?
  gatewayApiKeys  GatewayApiKey[]

  @@map("users")
}

model UserProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  nationality        String?   @db.VarChar(3)
  countryOfResidence String?   @map("country_of_residence") @db.VarChar(3)
  addressLine1       String?   @map("address_line_1") @db.VarChar(255)
  addressLine2       String?   @map("address_line_2") @db.VarChar(255)
  city               String?   @db.VarChar(100)
  postalCode         String?   @map("postal_code") @db.VarChar(20)
  avatarUrl          String?   @map("avatar_url") @db.VarChar(500)
  preferredCurrency  String    @default("EUR") @map("preferred_currency") @db.VarChar(3)
  preferredLanguage  String    @default("en") @map("preferred_language") @db.VarChar(5)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthSession {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  refreshTokenHash  String   @map("refresh_token_hash") @db.VarChar(255)
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(255)
  ipAddress         String   @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent") @db.Text
  isRevoked         Boolean  @default(false) @map("is_revoked")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model OtpCode {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  codeHash    String   @map("code_hash") @db.VarChar(255)
  type        String   @db.VarChar(20) // EMAIL, SMS, TWO_FA
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  isUsed      Boolean  @default(false) @map("is_used")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}


model SocialAccount {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(20) // "GOOGLE" | "APPLE"
  providerId String   @map("provider_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("social_accounts")
}

enum KycDocumentType {
  GOVERNMENT_ID
  PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
  SOURCE_OF_FUNDS
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model KycDocument {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  documentType    KycDocumentType   @map("document_type")
  documentUrl     String            @map("document_url") @db.VarChar(500)
  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

model KycVerificationAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(50) // "SUMSUB" | "MOCK"
  externalId String?  @map("external_id") @db.VarChar(100)
  status     String   @db.VarChar(20) // "INITIATED" | "APPROVED" | "REJECTED"
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_verification_attempts")
}

// ----------------------------------------
// ADMIN AUDIT TRAIL
// ----------------------------------------

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminId     String   @map("admin_id") @db.Uuid
  action      String   @db.VarChar(50)   // "KYC_APPROVED", "USER_SUSPENDED", "ROLE_CHANGED"
  targetType  String   @map("target_type") @db.VarChar(30) // "USER", "TRANSFER", "WALLET"
  targetId    String   @map("target_id") @db.Uuid
  metadata    Json?    @db.JsonB
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ----------------------------------------
// BLOCKCHAIN SETTLEMENT DOMAIN
// ----------------------------------------

model BlockchainTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  transferId    String   @unique @map("transfer_id") @db.Uuid
  sourceAddress String   @map("source_address") @db.VarChar(56)
  destAddress   String   @map("dest_address") @db.VarChar(56)
  amount        Decimal  @db.Decimal(18, 4)
  assetCode     String   @default("USDC") @map("asset_code") @db.VarChar(12)
  memo          String?  @db.VarChar(64)
  txHash        String?  @unique @map("tx_hash") @db.VarChar(64)
  ledger        Int?
  status        String   @db.VarChar(25) // PENDING, SUCCESS, FAILED, PENDING_VERIFICATION
  errorCode     String?  @map("error_code") @db.VarChar(40)
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("blockchain_transactions")
}

model StellarWallet {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  publicKey       String   @unique @map("public_key") @db.VarChar(56)
  encryptedSecret String   @map("encrypted_secret") @db.Text
  hasTrustline    Boolean  @default(false) @map("has_trustline")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("stellar_wallets")
}

model PointsAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  entries   PointsEntry[]

  @@map("points_accounts")
}

model PointsEntry {
  id          String        @id @default(uuid()) @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  account     PointsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Int           
  reason      String        @db.VarChar(50) // TRANSFER_EARNED, REFERRAL_BONUS, REDEEMED, EXPIRED
  referenceId String?       @map("reference_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@map("points_entries")
}

// ----------------------------------------
// AUDIT & COMPLIANCE DOMAIN
// ----------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(50)
  targetType  String?  @map("target_type") @db.VarChar(30)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AlertRecord {
  id          String   @id @default(uuid()) @db.Uuid
  ruleName    String   @map("rule_name") @db.VarChar(100)
  severity    String   @db.VarChar(20) // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status      String   @default("OPEN") @db.VarChar(20) // "OPEN", "INVESTIGATING", "RESOLVED"
  targetId    String?  @map("target_id") @db.Uuid
  targetType  String?  @map("target_type") @db.VarChar(50)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([ruleName])
  @@map("alert_records")
}

// ----------------------------------------
// B2B GATEWAY DOMAIN
// ----------------------------------------

model GatewayApiKey {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  keyHash       String   @unique @map("key_hash") @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  rateLimitTier Int      @default(10) @map("rate_limit_tier") // requests per second
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gateway_api_keys")
}


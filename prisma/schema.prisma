generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ----------------------------------------
// SHARED ENUMS
// ----------------------------------------

enum WalletType {
  USER
  SETTLEMENT
  FEE
  RESERVE
  PAYOUT
  LIQUIDITY
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

// ----------------------------------------
// FINANCIAL CORE DOMAIN
// ----------------------------------------

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String   @db.Uuid
  currency         String   @db.VarChar(5)
  wallet_type      WalletType
  stellar_public_key String?  @db.VarChar(56)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  accounts         LedgerAccount[]

  @@unique([user_id, currency])
  @@map("wallets")
}

model LedgerAccount {
  id               String   @id @default(uuid()) @db.Uuid
  wallet_id        String   @db.Uuid
  account_type     AccountType
  currency         String   @db.VarChar(5)
  name             String   @db.VarChar(100)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz

  wallet           Wallet   @relation(fields: [wallet_id], references: [id])
  entries          LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id                String   @id @default(uuid()) @db.Uuid
  transaction_id    String   @db.Uuid
  ledger_account_id String   @db.Uuid
  entry_type        EntryType
  amount            Decimal  @db.Decimal(18, 4)
  currency          String   @db.VarChar(5)
  description       String   @db.VarChar(255)
  reference_type    String?  @db.VarChar(30)
  reference_id      String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz

  account           LedgerAccount @relation(fields: [ledger_account_id], references: [id])

  @@index([ledger_account_id, created_at])
  @@index([transaction_id])
  @@map("ledger_entries")
}

enum TransferStatus {
  CREATED
  PENDING_KYC
  FX_LOCKED
  WALLET_DEBITED
  BLOCKCHAIN_PENDING
  COMPLETED
  FAILED
}

model Transfer {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  amount          Decimal        @db.Decimal(18, 4)
  currency        String         @db.VarChar(5)
  status          TransferStatus @default(CREATED)
  idempotencyKey  String         @unique @map("idempotency_key") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  @@map("transfers")
}

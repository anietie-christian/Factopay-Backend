{
  "name": "factopay",
  "version": "1.0.0",
  "description": "Fast · Secure · Near-Zero Fee Remittance from Europe & America to Africa.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "docker compose -f docker-compose.test.yml up -d && sleep 5 && dotenv -e .env.test -- prisma migrate deploy && (dotenv -e .env.test -- jest --detectOpenHandles; EXIT_CODE=$?; docker compose -f docker-compose.test.yml down; exit $EXIT_CODE)",
    "test:watch": "dotenv -e .env.test -- jest --watch",
    "test:cov": "dotenv -e .env.test -- jest --coverage",
    "test:debug": "docker compose -f docker-compose.test.yml up -d && sleep 2 && dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:migrate": "docker compose exec api npx prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1085.0",
    "@bull-board/api": "^5.20.1",
    "@bull-board/express": "^5.20.1",
    "@bull-board/nestjs": "^5.20.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/adapter-pg": "^5.17.0",
    "@prisma/client": "^5.17.0",
    "@sendgrid/mail": "^8.1.6",
    "@stellar/stellar-sdk": "^15.1.0",
    "async-mutex": "^0.5.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.10.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.2",
    "@nestjs/testing": "^10.3.10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.17.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "qs": "^6.15.2",
    "tar": "^7.5.16",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "webpack": "^5.104.1",
    "lodash": "^4.18.1",
    "glob": "^10.5.0",
    "js-yaml": "^5.2.1",
    "axios": "^1.16.0",
    "multer": "^2.2.0",
    "file-type": "^21.3.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
